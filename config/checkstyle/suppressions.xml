<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Checkstyle の除外設定。除外を追加する場合は理由を書く。
-->
<suppressions>
  <!-- テストメソッド名は日本語で「条件_期待結果」とする（開発標準書 1.3） -->
  <suppress checks="MethodName" files="[\\/]src[\\/]test[\\/]java[\\/]"/>
  <!-- 結合テストのクラス名は「…IT」とする（開発標準書 1.3）。日本語のテストメソッド名も大文字の略語判定に掛かるため除外する -->
  <suppress checks="AbbreviationAsWordInName" files="[\\/]src[\\/]test[\\/]java[\\/]"/>
  <!-- テストメソッドの Javadoc は、メソッド名が仕様を表すため省略する -->
  <suppress checks="MissingJavadocMethod" files="[\\/]src[\\/]test[\\/]java[\\/]"/>
  <suppress checks="MissingJavadocType" files="[\\/]src[\\/]test[\\/]java[\\/]"/>
</suppressions>
