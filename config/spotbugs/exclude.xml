<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs の除外設定。除外を追加する場合は理由を書く。
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.0.0/spotbugs/etc/findbugsfilter.xsd">
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2：DI で受け取った Bean（JobRepository など）をフィールドに保持すると検出される。
    Spring の Bean は共有して使うものであり、防御的コピーの対象ではないため除外する。
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!--
    CT_CONSTRUCTOR_THROW：コンストラクタで例外を送出するクラスの検出（ファイナライザ攻撃の対策）。
    本システムはファイナライザを使用せず、Spring が生成する Bean のみが対象のため除外する。
  -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
